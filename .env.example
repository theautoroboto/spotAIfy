# ── Non-sensitive (safe to keep in .env) ──────────────────────────────────────
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:9090
HISTORY_DIR=data/history
GRAPH_DIR=data/graph

# MusicBrainz — your real email, required by their API ToS
MUSICBRAINZ_CONTACT=your_email@example.com

# WhoSampled — optional, unlocks sample data (create a free account at whosampled.com)
WHOSAMPLED_USERNAME=

# ── Sensitive (prefer keyring — run: uv run python setup_secrets.py) ───────────
# Plain-text fallback: fill these in if you skip the keyring setup.
SPOTIFY_CLIENT_SECRET=your_client_secret_here
ANTHROPIC_API_KEY=your_anthropic_key_here
GENIUS_ACCESS_TOKEN=your_genius_client_access_token_here

# setlist.fm — free API key at https://api.setlist.fm/docs/1.0/index.html
SETLISTFM_API_KEY=your_setlistfm_api_key_here

# Hugging Face — get a free token at huggingface.co/settings/tokens (read-only is fine)
HF_TOKEN=your_hf_token_here

# WhoSampled password — omit if not using WhoSampled
WHOSAMPLED_PASSWORD=

# ── Web server ──────────────────────────────────────────────────────────────────
PORT=8000
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Comma-separated username:bcrypt_hash pairs
# Generate a hash: htpasswd -bnBC 10 "" yourpassword | tr -d ':\n'
USERS=alice:$2b$10$replacewithrealhash,bob:$2b$10$replacewithrealhash
# Spotify OAuth redirect URI for the web callback (register this in your Spotify app settings too)
SPOTIFY_WEB_REDIRECT_URI=http://localhost:8000/spotify/callback
